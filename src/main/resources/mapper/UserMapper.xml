<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiachangcai.mapper.UserMapper">
    <select id="selectAllUser" resultType="User">
        select
        user_id,username,password,nick_name,avatar,phone,member_type,member_expire,is_deleted,create_time,update_time
        from user
        where is_deleted = 0
    </select>
</mapper>
